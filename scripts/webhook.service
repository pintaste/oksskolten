[Unit]
Description=Oksskolten GitHub Webhook Receiver
After=network.target docker.service

[Service]
Type=simple
# Change User to whoever owns the repo and can run docker
User=ubuntu
WorkingDirectory=/home/ubuntu/oksskolten

Environment=WEBHOOK_PORT=9000
Environment=DEPLOY_BRANCH=main
Environment=WEBHOOK_SECRET_FILE=/etc/oksskolten/webhook-secret

ExecStart=/usr/bin/python3 /home/ubuntu/oksskolten/scripts/webhook.py
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=oksskolten-webhook

[Install]
WantedBy=multi-user.target
